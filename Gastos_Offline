     ) {

       showMessage(

         'Fecha u hora inválida',

         'Usá AAAA-MM-DD y HH:MM.'

       );

       return;

     }



     const [y, m, d] = rDate.split('-').map(Number);

     const [h, min] = rTime.split(':').map(Number);



     const when = new Date(y, m - 1, d, h, min);



     if (

       when.getFullYear() !== y ||

       when.getMonth() !== m - 1 ||

       when.getDate() !== d ||

       h > 23 ||

       min > 59

     ) {

       showMessage('Fecha u hora inválida', 'Revisá la fecha y la hora.');

       return;

     }



     if (when <= new Date()) {

       showMessage(

         'Fecha pasada',

         'Elegí una fecha y hora futuras.'

       );

       return;

     }



     let notificationId = null;

     let alarmMessage = '';



     if (Platform.OS === 'web') {

       if (

         typeof window !== 'undefined' &&

         'Notification' in window

       ) {

         if (window.Notification.permission === 'granted') {

           alarmMessage =

             'El recordatorio se guardará. El navegador permite notificaciones, pero esta versión no programa por sí sola una alarma futura en segundo plano.';

         } else if (window.Notification.permission === 'default') {

           const permission =

             await window.Notification.requestPermission();



           alarmMessage =

             permission === 'granted'

               ? 'El navegador autorizó las notificaciones. Para recibir una alarma futura fiable se necesita un mecanismo de programación web adicional.'

               : 'El recordatorio se guardará, pero el navegador no autorizó las notificaciones.';

         } else {

           alarmMessage =

             'El recordatorio se guardará, pero las notificaciones están bloqueadas en el navegador.';

         }

       } else {

         alarmMessage =

           'El recordatorio se guardará, pero este navegador no admite notificaciones.';

       }

     } else {

       const permission =

         await Notifications.requestPermissionsAsync();



       if (permission.status !== 'granted') {

         showMessage(

           'Permiso necesario',

           'Activá las notificaciones para programar la alarma.'

         );

         return;

       }



       if (Platform.OS === 'android') {

         await Notifications.setNotificationChannelAsync(

           'recordatorios',

           {

             name: 'Recordatorios de pagos',

             importance: Notifications.AndroidImportance.MAX,

             sound: 'default'

           }

         );

       }



       notificationId =

         await Notifications.scheduleNotificationAsync({

           content: {

             title: '⏰ Recordatorio de pago',
          body:
            '🔔 ' + title +
            ' · 📅 ' + fmtDate(rDate) +
            ' · ⏰ ' + rTime +
            (rAmount.trim()
              ? ' · 💰 ' + money(Number(rAmount.replace(',', '.')))
              : ''),
          sound: 'default',

             data: { type: 'payment' }

           },

           trigger: {

             type: Notifications.SchedulableTriggerInputTypes.DATE,

             date: when,

             channelId: 'recordatorios'

           }

         });



       alarmMessage = 'La alarma quedó programada en el dispositivo.';

     }



     const reminder = {

       id: uid(),

       title,

       amount: rAmount.trim()

         ? Number(rAmount.replace(',', '.'))

         : null,

       date: rDate,

       time: rTime,

       notificationId

     };



     await saveReminders([reminder, ...reminders]);



     setRModal(false);

     setRTitle('');

     setRAmount('');

     setRDate(today());

     setRTime('09:00');



     showMessage(

       'Recordatorio guardado',

       `${title}\n${fmtDate(rDate)} a las ${rTime}\n\n${alarmMessage}`

     );

   } catch (error) {

     console.error('Error al guardar el recordatorio:', error);



     showMessage(

       'Error al guardar',

       String(error?.message || 'No se pudo guardar el recordatorio.')

     );

   }

};



const cancelReminder = r => Alert.alert(
