              {isPast ? 'Vencimiento pasado' : r.notificationId ? 'Alarma programada con sonido' : 'Aviso guardado · alarma no programada en web'}
            </Text>
            <Pressable style={s.cancelReminderButton} onPress={()=>cancelReminder(r)}>
              <Text style={s.cancelReminderText}>Cancelar alarma</Text>
            </Pressable>
          </View>
        </View>;
      })}

  <Text style={s.note}>
    🔊 El sonido depende de los permisos y del volumen del dispositivo. Los recordatorios son de una sola vez: para un vencimiento mensual, programá la próxima fecha. La versión web guarda los avisos, pero no garantiza alarmas futuras cuando el navegador está cerrado.
  </Text>
</ScrollView>}

<View style={s.bottom}>{[['Gastos','⌂'],['Categorías','▥'],['Pagos','◷']].map(([t,i])=><Pressable key={t} onPress={()=>setTab(t)} style={s.nav}><Text style={[s.navIcon,tab===t&&s.navOn]}>{i}</Text><Text style={[s.navText,tab===t&&s.navOn]}>{t}</Text></Pressable>)}</View></>}

<Modal visible={modal} transparent animationType="slide" onRequestClose={()=>setModal(false)}><KeyboardAvoidingView style={s.overlay} behavior={Platform.OS==='ios'?'padding':undefined}><ScrollView contentContainerStyle={s.modalScroll} keyboardShouldPersistTaps="handled"><View style={s.modal}><View style={s.modalHead}><Text style={s.modalTitle}>{editing?'Editar gasto':'Nuevo gasto'}</Text><Pressable onPress={()=>setModal(false)}><Text style={s.close}>✕</Text></Pressable></View>{qrNotice!==''&&<Text style={s.qrNotice}>{qrNotice}</Text>}<Text style={s.label}>Descripción</Text><TextInput value={desc} onChangeText={setDesc} placeholder="Ej.: Alquiler de octubre" style={s.input}/><Text style={s.label}>Importe en pesos</Text><TextInput value={amount} onChangeText={setAmount} keyboardType="decimal-pad" placeholder="Ej.: 150000,50" style={s.input}/><Text style={s.label}>📅 Fecha de vencimiento (AAAA-MM-DD)</Text><TextInput value={date} onChangeText={setDate} placeholder="2026-10-24" style={s.input}/><Text style={s.label}>Categoría</Text><View style={s.catGrid}>{CATS.map(c=><Pressable key={c} onPress={()=>setCat(c)} style={[s.chip,cat===c&&s.chipOn]}><Text style={[s.chipText,cat===c&&s.chipTextOn]}>{CAT_EMOJI[c]||'📦'} {c}</Text></Pressable>)}</View><Pressable style={s.save} onPress={saveExpense}><Text style={s.saveText}>Guardar gasto</Text></Pressable></View></ScrollView></KeyboardAvoidingView></Modal>

<Modal visible={!!deleteTarget} transparent animationType="fade" onRequestClose={()=>setDeleteTarget(null)}><View style={s.confirmOverlay}><View style={s.confirmCard}><Text style={s.confirmTitle}>¿Eliminar gasto?</Text><Text style={s.confirmBody}>{deleteTarget?`${deleteTarget.description} · ${money(deleteTarget.amount)}`:''}</Text><Text style={s.confirmBody}>Esta acción no se puede deshacer.</Text><View style={s.confirmActions}><Pressable style={s.cancelDelete} onPress={()=>setDeleteTarget(null)}><Text style={s.cancelDeleteText}>Cancelar</Text></Pressable><Pressable style={s.confirmDelete} onPress={confirmDelete}><Text style={s.confirmDeleteText}>Sí, eliminar</Text></Pressable></View></View></View></Modal>

<Modal visible={rModal} transparent animationType="slide" onRequestClose={()=>setRModal(false)}><KeyboardAvoidingView style={s.overlay} behavior={Platform.OS==='ios'?'padding':undefined}><ScrollView contentContainerStyle={s.modalScroll} keyboardShouldPersistTaps="handled"><View style={s.modal}><View style={s.modalHead}><Text style={s.modalTitle}>⏰ 🔔 Nuevo recordatorio</Text><Pressable onPress={()=>setRModal(false)}><Text style={s.close}>✕</Text></Pressable></View><Text style={s.label}>🔔 Concepto del pago</Text><TextInput value={rTitle} onChangeText={setRTitle} placeholder="Alquiler, tarjeta, préstamo…" style={s.input}/><Text style={s.label}>💰 Importe opcional</Text><TextInput value={rAmount} onChangeText={setRAmount} keyboardType="decimal-pad" placeholder="150000" style={s.input}/><Text style={s.label}>📅 Fecha de vencimiento (AAAA-MM-DD)</Text><TextInput value={rDate} onChangeText={setRDate} placeholder="2026-11-05" style={s.input}/><Text style={s.label}>🕒 ⏰ Hora de la alarma (HH:MM)</Text><TextInput value={rTime} onChangeText={setRTime} placeholder="09:00" style={s.input}/><Pressable style={s.save} onPress={addReminder}><Text style={s.saveText}>🔔⏰ Guardar y programar alarma</Text></Pressable></View></ScrollView></KeyboardAvoidingView></Modal>

</SafeAreaView>}

